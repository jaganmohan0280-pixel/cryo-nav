# ==============================================================================
# CRYO NAV — Antarctic Navigation Decision Support System Environment Configuration
# ==============================================================================

# GEMINI_API_KEY:
# - Required for the AI Navigation Assistant.
# - Free tier available via Google AI Studio (no credit card required).
GEMINI_API_KEY=

# APP_URL:
# - Application base URL (optional / environment default).
APP_URL=

# POLAR TELEMETRY & EARTH OBSERVATION DATA:
# - Open-Meteo Antarctic Weather & ECMWF Marine Telemetry: Free & Open Access.
# - Copernicus Sentinel-1 SAR & NOAA/NSIDC Sea-Ice Feeds: Public scientific datasets.
# - Copernicus Data Space Ecosystem (CDSE) STAC & Product Access credentials (optional for restricted/high-volume access):
COPERNICUS_MARINE_USER=
COPERNICUS_MARINE_PASSWORD=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=


